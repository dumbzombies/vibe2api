{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mistral-vibe": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mistral Vibe",
      "options": {
        "baseURL": "http://127.0.0.1:8810/v1",
